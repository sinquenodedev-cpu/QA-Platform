# eFutures QA platform settings.
#
# Only the PLATFORM section is needed to start. Everything below it can be left empty
# and set later by an admin on the Settings page (stored encrypted in data/settings.json;
# a value saved there wins over this file).

# ===================== PLATFORM (needed on a server) =====================

PORT=4321
# Address to listen on. 127.0.0.1 = this machine only; 0.0.0.0 when hosted behind a proxy or in Docker.
HOST=127.0.0.1

# First admin login(s), username:password, comma separated (10+ characters). Used once to create
# data/testers.json; after that, add and remove testers on the Testers page in the tool.
QA_USERS=alice:change-me-to-a-long-password,bob:another-long-password

# Signs login sessions (any long random string). Without it, everyone is signed out when the tool restarts.
SESSION_SECRET=

# Encrypts the API keys, Jira tokens, database password and saved values stored in data/
# (any long random string). Keep it safe and never change it. If empty, a key is made in data/jira.key.
JIRA_TOKEN_KEY=

# Jira Cloud site. Each tester connects their own Jira account in the platform (Jira button next to
# their name). Each project picks its own Jira project key in its project settings.
JIRA_BASE_URL=https://ew2health-team.atlassian.net

# ===================== OPTIONAL (or set on the Settings page) =====================

# --- Sinque project: DEV database and API (Settings → Sinque database / Sinque app) ---
# Without these the platform runs normally; only the Sinque tools (test users, report checks) are off.
# DEV only: the tool refuses a database host that contains "prod" or lacks "dev".
# The database and the API must belong to the same environment:
#   dev: DATABASE_NAME=sinque-dev  API_BASE_URL=https://sinque-dev.efuturesworld.com
#   qa:  DATABASE_NAME=sinque-qa   API_BASE_URL=https://sinque-qa.efuturesworld.com
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
API_BASE_URL=
DASHBOARD_URL=https://dev-sinqueadmin.efuturesworld.com
# Password given to every test user and test professional the tool creates
TEST_PASSWORD=
# Optional dashboard admin (role 2) for the overview check. Without it the tool uses its
# own test professional ("QA Overview Bot"), made group manager of the user's group.
QA_DASHBOARD_EMAIL=
QA_DASHBOARD_PASSWORD=

# --- AI (Settings → AI). Without a key, the AI buttons are off; the rule checker still works. ---
# AI_PROVIDER: auto (the first with a key: Claude, OpenAI, Gemini), claude, openai, gemini or off
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# gpt-5.4-mini (default), gpt-5.4 or gpt-5.4-nano
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI requests per tester per day
AI_DAILY_LIMIT=300

# --- Jira extras (Settings → Jira) ---
# Sinque's Jira project key and the issue type for bugs.
JIRA_PROJECT=SA
JIRA_ISSUE_TYPE=Bug
# Optional shared account, used for testers who haven't connected their own Jira account.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
