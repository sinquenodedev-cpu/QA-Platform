# Sinque QA tool settings. DEV environment only:
# the tool refuses to start if a database host contains "prod" or lacks "dev".

# The database and the API must belong to the same environment:
#   dev: DATABASE_NAME=sinque-dev  API_BASE_URL=https://sinque-dev.efuturesworld.com
#   qa:  DATABASE_NAME=sinque-qa   API_BASE_URL=https://sinque-qa.efuturesworld.com
DATABASE_HOST=dev-sinque.cluster-xxxx.eu-north-1.rds.amazonaws.com
DATABASE_PORT=3306
DATABASE_NAME=sinque-dev
DATABASE_USERNAME=
DATABASE_PASSWORD=

# API of the same environment, used for reports and login checks (no trailing slash)
API_BASE_URL=https://sinque-dev.efuturesworld.com

# Password given to every test user and test professional the tool creates
TEST_PASSWORD=choose-a-test-password

PORT=4321
# Address to listen on. 127.0.0.1 = this machine only; 0.0.0.0 when hosted behind a proxy or in Docker.
HOST=127.0.0.1

# First admin login(s), username:password, comma separated (10+ characters). Used once to create
# data/testers.json; after that, add and remove testers on the Testers page in the tool.
QA_USERS=alice:change-me-to-a-long-password,bob:another-long-password

# Signs login sessions (any long random string). Without it, everyone is signed out when the tool restarts.
SESSION_SECRET=

# Every setting below can also be changed by an admin on the Settings page. A value saved there
# wins over this file (stored in data/settings.json, keys and passwords encrypted).

# AI features: Claude (Anthropic) or Gemini (Google). Without a key, the AI buttons are off; the rule checker still works.
# AI_PROVIDER: auto (the first with a key: Claude, OpenAI, Gemini), claude, openai, gemini or off
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# gpt-5.4-mini (default), gpt-5.4 or gpt-5.4-nano
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
# Optional: model and requests per tester per day
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=300

# Dev dashboard, for links to the real report page
DASHBOARD_URL=https://dev-sinqueadmin.efuturesworld.com
# Optional dashboard admin (role 2) for the overview check. Without it the tool uses its
# own test professional ("QA Overview Bot"), made group manager of the user's group.
QA_DASHBOARD_EMAIL=
QA_DASHBOARD_PASSWORD=

# Jira Cloud: create tickets from bug reports and show linked tickets. Off until EMAIL and TOKEN are set.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens (the account needs "Create issues" in the project)
JIRA_BASE_URL=https://ew2health-team.atlassian.net
JIRA_PROJECT=SA
JIRA_ISSUE_TYPE=Bug
JIRA_EMAIL=
JIRA_API_TOKEN=
# Testers can also connect their own Jira account in the platform (Jira button next to their name).
# Their tokens are stored encrypted in data/jira-users.json. Optional: the encryption key (else one is made in data/jira.key).
JIRA_TOKEN_KEY=
